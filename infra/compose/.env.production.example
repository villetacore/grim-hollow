# Copy to .env.production; never commit that file.
GAME_IMAGE=ghcr.io/OWNER/REPOSITORY:0.3.0
GAME_DOMAIN=game.example.com
# Generate: openssl rand -base64 32 (prefix APP_KEY with base64:)
APP_KEY=base64:REPLACE_WITH_RANDOM_KEY
# Generate two different secrets: openssl rand -hex 32
DB_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
