unit FieldGuide;
{$mode objfpc}{$H+}{$codepage utf8}
interface
uses Classes,Forms,Controls,StdCtrls,Graphics,GameTheme;
procedure ShowFieldGuide(Owner:TComponent);
implementation
procedure ShowFieldGuide(Owner:TComponent);
var Window:TForm;Text:TMemo;CloseButton:TButton;
begin
  Window:=TForm.CreateNew(Owner);
  try
    Window.Caption:='Полевой справочник — Три огня';Window.SetBounds(0,0,760,640);
    Window.Position:=poOwnerFormCenter;Window.Color:=PanelColor;Window.Font.Name:='Tahoma';Window.Font.Size:=11;
    CloseButton:=TButton.Create(Window);CloseButton.Parent:=Window;CloseButton.Align:=alBottom;
    CloseButton.Height:=40;CloseButton.Caption:='Вернуться в игру';CloseButton.ModalResult:=mrOK;CloseButton.Cancel:=True;
    Text:=TMemo.Create(Window);Text.Parent:=Window;Text.Align:=alClient;Text.ReadOnly:=True;
    Text.Color:=TownColor;Text.Font.Color:=GoldColor;Text.ScrollBars:=ssVertical;Text.WordWrap:=True;
    Text.Lines.Text:=
      'ЖИВОЙ ГОРОД'+LineEnding+
      'Вне похода герой гуляет по Пепельному пределу: WASD — ходить, F — поговорить с жителем рядом (или щёлкните его), 1–5 — жесты, T — все городские службы. Другие игроки видны с именами и уровнями, их сообщения общего чата всплывают над головой. Кузнец открывает кузницу, Сельма — алхимию, Оден — гильдии, Ива — торговую доску, жрица — таланты, глашатай — контракты, Кайра — наставников, Страж Врат и распорядитель арены — поход и дуэль. Манекены на тренировочном дворе покажут реальный урон. Врагов в городе нет.'+LineEnding+LineEnding+
      'СБОРКИ'+LineEnding+
      '8 классов: Страж (за щитом получает лишь четверть урона), Арканист (сила магии ×1,5), Следопыт (атака на 5 клеток), Хранитель (лечит союзников), Берсерк (×1,5 урона ниже половины HP), Убийца (+10% крита, крит ×3), Некромант (убийство даёт 8 MP и 5% HP), Друид (удары отравляют). 7 происхождений добавляют свои бонусы, нежить не боится яда. С 10 уровня — наставник другого класса: его черта и школы магии ваши. Заклинания своих школ стоят на четверть меньше маны (★ в книге).'+LineEnding+LineEnding+
      'РЕМЕСЛО'+LineEnding+
      'Вещь = основа × металл × свойство × руна × уровень. Металлы (сталь, мифрил, обсидиан, кость, ледостекло, жар-сталь, теневая сталь, живое дерево, болотное железо) умножают свойства; 3 вещи одного металла дают бонус комплекта, 5 — двойной. Руны режутся по готовым вещам. Металлам и рунам нужны реагенты: каждый вид врага роняет свой, химера — оба, сундуки тоже. Алхимик варит эликсир из двух реагентов на один поход; особые пары дают реакцию.'+LineEnding+LineEnding+
      'БЕСКОНЕЧНАЯ ГЛУБИНА'+LineEnding+
      'Подземелье не кончается. Каждые 3–5 этажей (зависит от области) выход стережёт босс; победив его, спускайтесь дальше [E] или возвращайтесь с добычей [X]. После первого цикла к врагам области примешиваются чудовища других областей, а боссы сменяют друг друга.'+LineEnding+
      'Сила врагов = средний уровень вашей группы + глубина. Сильная группа сразу встречает сильных врагов, так что поход всегда напряжённый, а награда растёт вместе с опасностью.'+LineEnding+
      'Первый босс области открывает следующую: шахты → монастырь → корни → катакомбы → ледник → цитадель → топь → бездна. Рекорд глубины попадает в таблицу лидеров и поднимает уровень, который умеет ковать кузнец.'+LineEnding+LineEnding+
      'ВРАЖЕСКИЕ ВАРИАЦИИ'+LineEnding+
      'Враги ходят одиночками, парами, стаями одного вида, смешанными отрядами и ковенами с лекарем. С глубиной они получают до трёх свойств: ядовитый, ледяной, бронированный, стремительный, гигант, вампир, колдун (стреляет издали), взрывной, шаман (лечит), пожиратель душ, берсерк, живучий, шипастый (ранит бьющего оружием), пылающий, делящийся (распадается надвое), вожак (усиливает соседей), мерцающий, призрачный (уклоняется от оружия), заговорённый (гасит магию), колосс. Свойства видны в имени врага.'+LineEnding+
      'ХИМЕРЫ (фиолетовый ромб): с 8 уровня врагов два вида сплетаются в одно существо со способностями обоих. Химера засчитывается за оба вида и роняет оба реагента.'+LineEnding+
      'ЗНАМЕНИЯ: со второго этажа этаж может получить знамение — кровавая луна, нашествие, сокровищница, непроглядная тьма, благословение, час чемпионов, укрепление, проклятая земля, сплетение. Они видны над картой.'+LineEnding+LineEnding+
      'ВРАГИ'+LineEnding+
      'У каждой области свой набор чудовищ. Плевальщики, упыри и терновые стрелки отравляют; корневые ползуны, волки и ведьмы изморози замедляют; призраки и ученики лича выпивают ману; послушники лечат соседей; спорные пузыри и магмовые громилы взрываются при смерти — не стойте рядом. Броня рыцарей и големов режет обычные удары, но не магию.'+LineEnding+
      'Матёрые враги (золотая рамка) крепче и приносят двойную награду, эссенцию и вещь. Боссы (красная рамка и корона) призывают подмогу и бьют по площади.'+LineEnding+LineEnding+
      'ПОДЗЕМЕЛЬЕ'+LineEnding+
      'F рядом с объектом: сундук — кроны, зелье и шанс на снаряжение; родник — половина здоровья и вся мана, снимает яд; алтарь ярости — +5 к урону на 30 секунд. Шипы ловушек срабатывают один раз под ногами.'+LineEnding+LineEnding+
      'ПЕРВЫЙ ПОХОД'+LineEnding+
      '1. Создайте аккаунт и героя во вкладке «Аккаунт». Страж крепче в ближнем бою; арканист сильнее в магии; следопыт стреляет на 5 клеток; хранитель умеет исцелять союзников.'+LineEnding+
      '2. Во вкладке «Вещи» наденьте запасное кольцо. Во вкладке «Поход» выберите первую область и нажмите «Подготовить / присоединиться».'+LineEnding+
      '3. Для группы (до 8 героев) передайте код друзьям: они должны присоединиться до старта. Затем лидер нажимает «Начать».'+LineEnding+
      '4. Щёлкните карту или нажмите Esc, чтобы управлять героем. Поле ввода чата перехватывает буквы.'+LineEnding+LineEnding+
      'УПРАВЛЕНИЕ'+LineEnding+
      'WASD / стрелки — шаг; Space — атака ближайшего врага в радиусе.'+LineEnding+
      '1 — щитовой удар; 2 — защита; 3 — выпить зелье.'+LineEnding+
      'Магия: 4 огненная стрела, 5 исцеление, 6 ледяное копьё, 7 кольцо пламени, 8 ядовитый шип, 9 цепная молния, 0 святой барьер, Q метеор, Z скачок, C огненная волна, V вихрь клинков, G похищение жизни, B кровавая ярость, N хватка корней, M костяное копьё, H святилище (лечит всех рядом).'+LineEnding+
      'ЦЕЛЬ: щёлкните врага (правый щелчок — сразу удар) или нажмите Tab. Прицельные заклинания бьют выбранную цель, без неё — ближайшую. Скачок и огненная волна летят по направлению последнего шага.'+LineEnding+
      'ПЕРЕЗАРЯДКИ: у щитового удара, защиты, зелья и каждого заклинания своя перезарядка. Панель под картой показывает её тёмной шторкой с секундами; оранжевая рамка — не хватает маны или зелий.'+LineEnding+
      'ТУМАН ВОЙНЫ: исследованные места остаются на карте и миникарте затемнёнными; враги видны только в поле зрения.'+LineEnding+
      'ДУЭЛИ: во вкладке «Поход» выберите режим «Дуэль», подготовьте и передайте код сопернику. Бой на арене до победы (3 минуты, затем ничья), урон по героям снижен. Победа поднимает рейтинг Эло, золото и вещи не меняются.'+LineEnding+
      'F — открыть сундук, испить из родника или коснуться алтаря.'+LineEnding+
      'E — спуститься дальше у выхода; X — эвакуироваться у выхода.'+LineEnding+
      'R — поднять соседнего павшего союзника: начать за 20 секунд, выдержать 3 секунды без урона. На следующий этаж группа несёт один заряд воскрешения на весь поход.'+LineEnding+
      'T — городские службы; F1 — этот справочник. Онлайн-мир не ставится на паузу при открытии окна.'+LineEnding+LineEnding+
      'РИСК И НАГРАДА'+LineEnding+
      'Золото, вещи и весь опыт похода сохраняются после эвакуации. При поражении сохраняется четверть опыта; добыча теряется. Ваше городское снаряжение остаётся. Лучше уйти раньше, чем потерять всё.'+LineEnding+LineEnding+
      'МЕЖДУ ПОХОДАМИ'+LineEnding+
      'Во вкладке «Герой» распределяйте очки характеристик. В городе: разбирайте снятые вещи, куйте предметы, запасайте зелья, покупайте и продавайте на доске. Надетая вещь привязывается и больше не продаётся игрокам. Комиссия рынка — 5% с округлением вверх.'+LineEnding+
      'Во вкладке «Хроника и контракты» городских служб выбирайте таланты (одно очко каждые 3 уровня), берите контракты на врагов и смотрите прогресс кампании. Сброс характеристик и талантов бесплатный.'+LineEnding+
      'КУЗНИЦА: 21 основа (клинки, секиры, молоты, кинжалы, булавы, посохи, жезлы, луки, арбалеты, мантии, куртки, кольчуги, латы, щиты, фолианты, сферы, колчаны, кольца, печатки, амулеты, талисманы) любого уровня и 8 свойств (ярость, стойкость, чародейство, жизнь, мудрость, равновесие, меткость — крит, кровь — вампиризм). Вещи улучшаются на +1 и перезачаровываются. Плюс 32 именных рецепта.'+LineEnding+
      'Эссенция выпадает с боссов, матёрых и сильно изменённых врагов, получается разбором вещей от +5 или перегонкой материалов.'+LineEnding+
      'В городе также доступны друзья и гильдии. Чат: общий, групповой и гильдейский; Enter отправляет сообщение, Esc возвращает фокус карте.';
    Text.SelStart:=0;Window.ShowModal;
  finally Window.Free;end;
end;
end.
